#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  puts "\n== Vendoring JavaScript (Turbo, Stimulus, ActionCable) =="
  # config/importmap.rb already lists the pins this app needs; this just
  # downloads the actual files into vendor/javascript so the browser can
  # load them (skips any pin that's already vendored).
  system!("bin/importmap pin @hotwired/turbo-rails @hotwired/stimulus @hotwired/stimulus-loading @rails/actioncable") if File.exist?("bin/importmap")

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"

  puts "\n== Seeding demo data =="
  system! "bin/rails db:seed"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  puts "\n== Ready! =="
  puts "Run `bin/dev` to start the server, then open http://localhost:3000"
end
