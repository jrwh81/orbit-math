<% content_for :title, "Leaderboard" %>

<section class="hero hero-compact">
  <h1>Leaderboard</h1>
  <p class="hero-copy">Ranked by total points within each difficulty &mdash; a Beginner regular and an Expert grinder aren't really competing on the same scale, so they don't share a table.</p>
</section>

<% @leaderboards.each do |difficulty, stats| %>
  <section class="card card-wide">
    <h2><%= PuzzleGenerator::DIFFICULTY_LEVELS.dig(difficulty, :label) %></h2>
    <% if stats.any? %>
      <div class="game-list-scroll">
        <ol class="game-list">
          <% stats.each_with_index do |stat, i| %>
            <li>
              <strong>#<%= i + 1 %> <%= stat.user.name %></strong>
              &middot; <%= stat.total_points %> pts
              &middot; <%= stat.games_won %> wins
              &middot; <%= stat.targets_claimed %> prizes won
              &middot; <%= stat.games_played %> games played
            </li>
          <% end %>
        </ol>
      </div>
    <% else %>
      <p class="muted">No games played at this difficulty yet.</p>
    <% end %>
  </section>
<% end %>
