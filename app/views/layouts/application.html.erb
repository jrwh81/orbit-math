<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) ? "#{content_for(:title)} · #{@game.name}" : "#{@game.name} — #{@game.tagline}" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="<%= @game.name %>">
    <meta name="theme-color" content="#0b0e21">
    <meta name="description" content="<%= @game.tagline %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Social share preview (Open Graph + Twitter Card) -- defaults to
        the homepage's own art/copy on every page unless a specific page
        overrides them via content_for(:og_title) etc. og:image MUST be
        an absolute URL (relative paths are silently ignored by every
        platform that reads these tags), hence request.base_url rather
        than just the public/ path. See public/og-image.jpg -- a real
        screenshot of the actual grid mid-claim (points + chain-bonus
        popups caught in the moment), not a generic logo card. %>
    <% og_title = content_for(:og_title) || "#{@game.name} — #{@game.tagline}" %>
    <% og_description = content_for(:og_description) || "Link numbers with addition and multiplication to win real prizes. Play free, no signup needed." %>
    <% og_image_url = "#{request.base_url}/og-image.jpg" %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= @game.name %>">
    <meta property="og:title" content="<%= og_title %>">
    <meta property="og:description" content="<%= og_description %>">
    <meta property="og:image" content="<%= og_image_url %>">
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= og_title %>">
    <meta name="twitter:description" content="<%= og_description %>">
    <meta name="twitter:image" content="<%= og_image_url %>">

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header" data-controller="nav">
      <%= link_to root_path, class: "brand" do %>
        <span class="brand-mark">&#9737;</span> <span class="brand-name"><%= @game.name %></span>
      <% end %>

      <button type="button" class="nav-toggle" data-action="nav#toggle" aria-label="Menu" aria-expanded="false">
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>

      <nav class="site-nav" data-nav-target="menu">
        <%= link_to "Play a Game", play_path, class: "btn btn-small btn-play" %>
        <% if logged_in? %>
          <%= link_to "Solo", new_solo_game_path %>
          <%= link_to "Multiplayer", multiplayer_games_path %>
          <%= link_to "Leaderboard", leaderboard_path %>
          <% if current_user.admin? %>
            <%= link_to "Admin", admin_root_path %>
          <% end %>
          <span class="nav-user"><%= current_user.name %></span>
          <%= button_to "Log out", logout_path, method: :delete, class: "link-button" %>
        <% else %>
          <%= link_to "Leaderboard", leaderboard_path %>
          <%= link_to "Log in", login_path %>
          <%= link_to "Sign up", signup_path, class: "btn btn-small" %>
        <% end %>
      </nav>
    </header>

    <% if notice %>
      <p class="flash flash-notice"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p class="flash flash-alert"><%= alert %></p>
    <% end %>

    <main class="site-main">
      <%= yield %>
    </main>

    <footer class="site-footer">
      <p><%= @game.name %> &mdash; <%= @game.tagline %></p>
    </footer>
  </body>
</html>
