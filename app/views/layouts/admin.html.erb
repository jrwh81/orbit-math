<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) ? "Admin · #{content_for(:title)}" : "Admin" %> · <%= @game.name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header" data-controller="nav">
      <%= link_to "Admin · #{@game.name}", admin_root_path, class: "brand" %>

      <button type="button" class="nav-toggle" data-action="nav#toggle" aria-label="Menu" aria-expanded="false">
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>

      <nav class="site-nav" data-nav-target="menu">
        <%= link_to "Dashboard", admin_root_path %>
        <%= link_to "Users", admin_users_path %>
        <%= link_to "Games", admin_game_sessions_path %>
        <%= link_to "Back to site", root_path %>
        <span class="nav-user"><%= current_user.name %></span>
      </nav>
    </header>

    <% if notice %>
      <p class="flash flash-notice"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p class="flash flash-alert"><%= alert %></p>
    <% end %>

    <main class="site-main admin-main">
      <%= yield %>
    </main>
  </body>
</html>
