<div class="game-board-wrap"
     data-controller="grid<%= " multiplayer" if mode == "multiplayer" %>"
     data-grid-submit-url-value="<%= submit_url %>"
     data-grid-finish-url-value="<%= mode == "solo" ? finish_solo_game_path(game_session) : finish_multiplayer_game_path(game_session) %>"
     data-grid-new-game-url-value="<%= mode == "solo" ? new_solo_game_path : multiplayer_games_path %>"
     data-grid-home-url-value="<%= root_path %>"
     data-grid-current-user-id-value="<%= current_user.id %>"
     data-grid-state-value="<%= game_state.to_json %>"
     <% if mode == "multiplayer" %>
       data-multiplayer-game-session-id-value="<%= game_session.id %>"
       data-multiplayer-current-user-id-value="<%= current_user.id %>"
     <% end %>>

  <div class="scoreboard" data-grid-target="scoreboard">
    <!-- rendered by grid_controller.js from state -->
  </div>

  <div class="timer-indicator" data-grid-target="timer">
    <!-- countdown clock rendered by grid_controller.js -->
  </div>

  <div class="targets-row-wrap">
    <p class="targets-label">Prizes on offer</p>
    <div class="targets-row" data-grid-target="targets">
      <!-- prize chips rendered by grid_controller.js -->
    </div>
  </div>

  <div class="expression-bar">
    <span class="expression" data-grid-target="expression">&mdash;</span>
    <span class="points-total" data-grid-target="pointsTotal">0 pts</span>
  </div>

  <div class="grid-stage">
    <div class="grid" data-grid-target="grid">
      <!-- cells rendered by grid_controller.js -->
    </div>
    <div class="solve-popup-layer" data-grid-target="popupLayer">
      <!-- floating "3 + 5 = 8" and "+300 pts" popups appended here on each claim -->
    </div>
  </div>

  <p class="grid-help">
    Link numbers with <strong>addition</strong> and <strong>multiplication</strong> to match a
    prize above and win it &mdash; the moment your chain adds up, it's claimed
    automatically and a fresh prize rotates in. Click a neighbor to add it,
    double-click to multiply, or cross diagonally through the x at the
    corner of any four numbers. Every prize has its own point value, and
    reaching for bigger digits pays off: chains that only touch 1&ndash;3
    score <strong>3&times;</strong> points, 4&ndash;6 scores
    <strong>5&times;</strong>, and 7&ndash;9 scores <strong>8&times;</strong>
    &mdash; so the same prize can be worth very different amounts
    depending on how ambitious your chain is.
  </p>

  <div class="game-message" data-grid-target="message"></div>

  <div data-grid-target="completion">
    <!-- populated by grid_controller.js the instant the game completes -->
  </div>
</div>
