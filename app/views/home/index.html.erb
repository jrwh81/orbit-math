<section class="hero">
  <h1><%= @game.name %></h1>
  <p class="tagline"><%= @game.tagline %></p>
  <p class="hero-copy">
    Link adjacent asteroids together to hit the cargo targets below the grid.
    Click a neighbor to <strong>add</strong> it to your chain, double-click a
    neighbor to <strong>multiply</strong>. Solve it solo, or beam aboard a
    live match and race an opponent for the same haul.
  </p>

  <div class="hero-actions">
    <% if logged_in? %>
      <%= link_to "Play Solo", new_solo_game_path, class: "btn btn-primary" %>
      <%= link_to "Multiplayer Lobby", multiplayer_games_path, class: "btn btn-secondary" %>
    <% else %>
      <%= link_to "Sign up to play", signup_path, class: "btn btn-primary" %>
      <%= link_to "Log in", login_path, class: "btn btn-secondary" %>
    <% end %>
  </div>
</section>

<section class="how-to-play">
  <h2>How to Play</h2>

  <div class="how-to-content">
    <div class="demo-board" aria-hidden="true">
      <div class="grid-stage">
        <div class="grid">
          <svg class="chain-svg" viewBox="0 0 100 100" preserveAspectRatio="none">
            <line class="chain-line chain-line-add" x1="25" y1="25" x2="75" y2="25"></line>
            <line class="chain-line chain-line-multiply" x1="75" y1="25" x2="75" y2="75"></line>
          </svg>
          <div class="grid-rows">
            <div class="grid-row">
              <div class="cell selected" data-shape="0"><span class="cell-value">3</span><span class="cell-order">1</span></div>
              <div class="cell selected" data-shape="1"><span class="cell-value">5</span><span class="cell-order">2</span></div>
            </div>
            <div class="grid-row">
              <div class="cell" data-shape="2"><span class="cell-value">7</span></div>
              <div class="cell selected" data-shape="3"><span class="cell-value">4</span><span class="cell-order">3</span></div>
            </div>
          </div>
        </div>
      </div>
      <div class="demo-expression">3 + 5 &times; 4 = 32</div>
      <p class="demo-caption">Example chain &mdash; not a live game</p>
    </div>

    <ol class="how-to-steps">
      <li><strong>Click</strong> an asteroid to start a chain.</li>
      <li><strong>Click</strong> a neighboring asteroid to <strong>add</strong> it &mdash; like 3 &rarr; 5 above.</li>
      <li><strong>Double-click</strong> a neighboring asteroid to <strong>multiply</strong> instead &mdash; like 5 &rarr; 4 above.</li>
      <li>Match a cargo target below the grid and it's claimed <strong>automatically</strong> &mdash; no submit button needed.</li>
      <li>Claimed numbers get replaced with fresh ones. Chain as many as you can before time runs out!</li>
    </ol>
  </div>
</section>

<% if logged_in? %>
  <section class="dashboard">
    <div class="card">
      <h2>Your stats</h2>
      <ul class="stat-list">
        <li><span><%= @stat.games_played %></span> games played</li>
        <li><span><%= @stat.games_won %></span> games won (<%= @stat.win_rate %>%)</li>
        <li><span><%= @stat.targets_claimed %></span> targets claimed</li>
        <li><span><%= @stat.best_solo_score %></span> best solo run</li>
      </ul>
    </div>

    <div class="card card-wide">
      <h2>Open multiplayer games</h2>
      <% if @open_games.any? %>
        <div class="game-list-scroll">
          <ul class="game-list">
            <% @open_games.each do |g| %>
              <li>
                hosted by <%= g.host.name %> &middot; code <strong><%= g.join_code %></strong>
                &middot; <span class="difficulty-badge"><%= g.puzzle.difficulty_label %></span>
                <%= button_to "Join", join_multiplayer_game_path, params: { code: g.join_code }, class: "btn btn-small" %>
              </li>
            <% end %>
          </ul>
        </div>
      <% else %>
        <p class="muted">No open games right now &mdash; <%= link_to "host one", multiplayer_games_path %>.</p>
      <% end %>
    </div>

    <div class="card card-wide">
      <h2>Recent games</h2>
      <% if @recent_games.any? %>
        <div class="game-list-scroll">
          <ul class="game-list">
            <% @recent_games.each do |g| %>
              <li>
                <strong><%= current_user.name %></strong>
                <% if g.multiplayer? %>
                  <% opponent = g.opponent_of(current_user) %>
                  vs <%= opponent ? opponent.name : "no opponent yet" %>
                <% else %>
                  &middot; Solo run
                <% end %>
                &middot; <span class="difficulty-badge"><%= g.puzzle.difficulty_label %></span>
                &middot; <%= g.points_for(current_user) %> pts
                <% unless g.completed? %>
                  &middot; <%= link_to "Open", g.solo? ? solo_game_path(g) : multiplayer_game_path(g) %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% else %>
        <p class="muted">No games yet. Start one above!</p>
      <% end %>
    </div>
  </section>
<% end %>
