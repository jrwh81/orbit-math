<section class="hero">
  <h1><%= @game.name %></h1>
  <p class="tagline"><%= @game.tagline %></p>
  <p class="hero-copy">
    Link adjacent asteroids together to hit the cargo targets below the grid.
    Click a neighbor to <strong>add</strong> it to your chain, double-click a
    neighbor to <strong>multiply</strong>. Solve it solo, or beam aboard a
    live match and race an opponent for the same haul.
  </p>

  <div class="hero-actions">
    <% if logged_in? %>
      <%= link_to "Play Solo", new_solo_game_path, class: "btn btn-primary" %>
      <%= link_to "Multiplayer Lobby", multiplayer_games_path, class: "btn btn-secondary" %>
    <% else %>
      <%= link_to "Sign up to play", signup_path, class: "btn btn-primary" %>
      <%= link_to "Log in", login_path, class: "btn btn-secondary" %>
    <% end %>
  </div>
</section>

<% if logged_in? %>
  <section class="dashboard">
    <div class="card">
      <h2>Your stats</h2>
      <ul class="stat-list">
        <li><span><%= @stat.games_played %></span> games played</li>
        <li><span><%= @stat.games_won %></span> games won (<%= @stat.win_rate %>%)</li>
        <li><span><%= @stat.targets_claimed %></span> targets claimed</li>
        <li><span><%= @stat.best_solo_score %></span> best solo run</li>
      </ul>
    </div>

    <div class="card">
      <h2>Open multiplayer games</h2>
      <% if @open_games.any? %>
        <ul class="game-list">
          <% @open_games.each do |g| %>
            <li>
              hosted by <%= g.host.name %> &middot; code <strong><%= g.join_code %></strong>
              &middot; <span class="difficulty-badge"><%= g.puzzle.difficulty_label %></span>
              <%= button_to "Join", join_multiplayer_game_path, params: { code: g.join_code }, class: "btn btn-small" %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="muted">No open games right now &mdash; <%= link_to "host one", multiplayer_games_path %>.</p>
      <% end %>
    </div>

    <div class="card">
      <h2>Recent games</h2>
      <% if @recent_games.any? %>
        <ul class="game-list">
          <% @recent_games.each do |g| %>
            <li>
              <%= g.mode.capitalize %> &middot; <%= g.status %>
              &middot; <span class="difficulty-badge"><%= g.puzzle.difficulty_label %></span> &middot;
              <%= link_to "Open", g.solo? ? solo_game_path(g) : multiplayer_game_path(g) %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="muted">No games yet. Start one above!</p>
      <% end %>
    </div>
  </section>
<% end %>
