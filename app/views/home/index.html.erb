<section class="hero">
  <h1><%= @game.name %></h1>
  <p class="tagline"><%= @game.tagline %></p>
  <p class="hero-copy">
    Link numbers with <strong>addition</strong> and <strong>multiplication</strong>
    to win the prizes waiting at the top of the grid. Every prize pays out
    real points, and reaching for bigger digits multiplies your score up to
    <strong>8&times;</strong> &mdash; solve it solo, or beam aboard a live
    match and race an opponent for the same haul.
  </p>

  <div class="hero-actions">
    <% if logged_in? %>
      <%= link_to "Play Solo", new_solo_game_path, class: "btn btn-primary" %>
      <%= link_to "Multiplayer Lobby", multiplayer_games_path, class: "btn btn-secondary" %>
    <% else %>
      <%= link_to "Sign up to play", signup_path, class: "btn btn-primary" %>
      <%= link_to "Log in", login_path, class: "btn btn-secondary" %>
    <% end %>
  </div>
</section>

<section class="how-to-play">
  <h2>How to Play</h2>

  <div class="how-to-content">
    <div class="demo-board" aria-hidden="true">
      <div class="grid-stage">
        <div class="grid">
          <div class="grid-rows" style="grid-template-columns: 1fr minmax(6px, 0.22fr) 1fr; grid-template-rows: 1fr minmax(6px, 0.22fr) 1fr;">
            <button type="button" class="cell selected" style="grid-row:1;grid-column:1;">
              <span class="cell-value cell-value-low">3</span><span class="cell-order">1</span>
            </button>
            <span class="connector connector-horizontal connector-active connector-plus" style="grid-row:1;grid-column:2;">+</span>
            <button type="button" class="cell selected" style="grid-row:1;grid-column:3;">
              <span class="cell-value cell-value-mid">5</span><span class="cell-order">2</span>
            </button>

            <span class="connector connector-vertical" style="grid-row:2;grid-column:1;">&ndash;</span>
            <span class="connector connector-diagonal connector-diagonal-tlbr" style="grid-row:2;grid-column:2;"></span>
            <span class="connector connector-diagonal connector-diagonal-trbl" style="grid-row:2;grid-column:2;"></span>
            <span class="connector connector-vertical connector-active connector-times" style="grid-row:2;grid-column:3;">&times;</span>

            <button type="button" class="cell" style="grid-row:3;grid-column:1;">
              <span class="cell-value cell-value-neutral">7</span>
            </button>
            <span class="connector connector-horizontal" style="grid-row:3;grid-column:2;">&ndash;</span>
            <button type="button" class="cell selected" style="grid-row:3;grid-column:3;">
              <span class="cell-value cell-value-mid">4</span><span class="cell-order">3</span>
            </button>
          </div>
        </div>
      </div>
      <div class="demo-expression">3 + 5 &times; 4 = 32</div>
      <p class="demo-caption">Example chain &mdash; not a live game</p>
    </div>

    <ol class="how-to-steps">
      <li><strong>Click</strong> a number to start a chain &mdash; it lights up with its own color once it's picked, like 3 and 5 above.</li>
      <li><strong>Click</strong> a neighboring number to <strong>add</strong> it &mdash; like 3 &rarr; 5 above, shown by the glowing <strong>+</strong> between them.</li>
      <li><strong>Double-click</strong> a neighboring number to <strong>multiply</strong> instead &mdash; like 5 &rarr; 4 above, shown by the <strong>&times;</strong>.</li>
      <li>Diagonal neighbors count too &mdash; every group of four numbers has a faint <strong>x</strong> mark where they meet. Link across it and that arm lights up into a <strong>+</strong> or <strong>&times;</strong>, just like 3 and 7 could here.</li>
      <li>Match a prize above the grid and it's won <strong>automatically</strong> &mdash; no submit button needed.</li>
      <li>Every prize has its own point value, and reaching for bigger digits multiplies it: chains that stay in the 1&ndash;3 range score <strong>3&times;</strong> points, 4&ndash;6 scores <strong>5&times;</strong>, and 7&ndash;9 scores <strong>8&times;</strong> &mdash; the bigger the number you dare to link, the bigger the payout.</li>
      <li>Won numbers get replaced with fresh ones. Chain as many prizes as you can before time runs out!</li>
    </ol>
  </div>
</section>

<% if logged_in? %>
  <section class="dashboard">
    <div class="card">
      <h2>Your stats</h2>
      <ul class="stat-list">
        <li><span><%= @stat.games_played %></span> games played</li>
        <li><span><%= @stat.games_won %></span> games won (<%= @stat.win_rate %>%)</li>
        <li><span><%= @stat.targets_claimed %></span> prizes won</li>
        <li><span><%= @stat.best_solo_score %></span> best solo run</li>
      </ul>
    </div>

    <div class="card card-wide">
      <h2>Open multiplayer games</h2>
      <% if @open_games.any? %>
        <div class="game-list-scroll">
          <ul class="game-list">
            <% @open_games.each do |g| %>
              <li>
                hosted by <%= g.host.name %> &middot; code <strong><%= g.join_code %></strong>
                &middot; <span class="difficulty-badge"><%= g.puzzle.difficulty_label %></span>
                <%= button_to "Join", join_multiplayer_game_path, params: { code: g.join_code }, class: "btn btn-small" %>
              </li>
            <% end %>
          </ul>
        </div>
      <% else %>
        <p class="muted">No open games right now &mdash; <%= link_to "host one", multiplayer_games_path %>.</p>
      <% end %>
    </div>

    <div class="card card-wide">
      <h2>All games</h2>
      <% if @all_games.any? %>
        <div class="game-list-scroll">
          <ul class="game-list">
            <% @all_games.each do |g| %>
              <% players = g.participants.sort_by(&:player_number).map(&:user) %>
              <li>
                <% if g.multiplayer? %>
                  <% p1, p2 = players %>
                  <% result = multiplayer_result(g, p1, p2) %>
                  <% if result.nil? %>
                    <strong><%= p1&.name %></strong> vs no opponent yet
                  <% elsif result[:status] == :winner %>
                    Winner: <strong class="winner-name"><%= result[:winner].name %></strong> (<%= result[:winner_points] %> pts)
                    &middot; Opponent: <%= result[:loser].name %> (<%= result[:loser_points] %> pts)
                  <% elsif result[:status] == :tie %>
                    Tie: <%= result[:player_one].name %> (<%= result[:p1_points] %> pts)
                    vs <%= result[:player_two].name %> (<%= result[:p2_points] %> pts)
                  <% else %>
                    <%= result[:player_one].name %> (<%= result[:p1_points] %> pts)
                    vs <%= result[:player_two].name %> (<%= result[:p2_points] %> pts)
                    &middot; <span class="muted">in progress</span>
                  <% end %>
                <% else %>
                  <strong><%= players.first&.name %></strong> &middot; Solo run
                  &middot; <%= g.points_for(players.first) %> pts
                <% end %>
                &middot; <span class="difficulty-badge"><%= g.puzzle.difficulty_label %></span>
                <% if !g.completed? && current_user && g.participants.any? { |p| p.user_id == current_user.id } %>
                  &middot; <%= link_to "Open", g.solo? ? solo_game_path(g) : multiplayer_game_path(g) %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% else %>
        <p class="muted">No games played yet. Start one above!</p>
      <% end %>
    </div>
  </section>
<% end %>
