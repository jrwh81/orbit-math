# Copy to .env and adjust for local development.

# --- Branding: this is the ONLY thing you need to change to rename the game ---
GAME_NAME=OrbitMath
GAME_TAGLINE=Link numbers. Beat the belt. Race for the loot.

# --- Gameplay tuning ---
GAME_GRID_SIZE=5
GAME_TARGET_COUNT=6

# --- Database (defaults work for a default local Postgres install) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=

# --- Google/Facebook sign-in (see OAUTH.md for how to get these) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# The "Continue with Facebook" button is hidden from public view until
# this is "true" -- the credentials above work fine for testers, but the
# app isn't through Meta's App Review yet, so a non-tester who clicks it
# hits a dead-end error straight from Facebook. Flip this once you're
# out of Development mode.
FACEBOOK_LOGIN_PUBLIC=false
